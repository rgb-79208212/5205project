{
  "type": "object",
  "required": [
    "subquestions",
    "searches"
  ],
  "properties": {
    "subquestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "requires_full_text",
          "min_sources",
          "criteria",
          "synthesis_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[1-3]$"
          },
          "question": {
            "type": "string",
            "minLength": 5,
            "maxLength": 400
          },
          "requires_full_text": {
            "type": "boolean"
          },
          "min_sources": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "synthesis_required": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^Q[1-3]$"
            }
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^Q[1-3]\\.C[1-4]$"
                },
                "description": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 250
                }
              }
            }
          },
          "skill": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "searches": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "query"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          },
          "original_title": {
            "type": "string",
            "minLength": 12,
            "maxLength": 180
          },
          "start_year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 3000
          },
          "end_year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 3000
          },
          "tool": {
            "enum": [
              "search_papers",
              "search_datasets",
              "search_encyclopedia"
            ]
          }
        }
      }
    },
    "read_requests": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "source_id"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    }
  }
}